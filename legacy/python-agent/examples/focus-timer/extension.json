{
  "api_version": 1,
  "id": "org.3decks.focus-timer",
  "version": "1.0.0",
  "name": {"en": "Focus timer", "fr": "Minuteur Focus"},
  "description": {"en": "Focus and break timers with a live dashboard and ready-to-use buttons. No network access needed.", "fr": "Concentration et pauses avec un écran en direct et des boutons prêts à utiliser. Aucun accès réseau nécessaire."},
  "author": "3Decks contributors",
  "runtime": "python",
  "entrypoint": "main.py",
  "platforms": ["darwin", "win32", "linux"],
  "permissions": ["filesystem"],
  "poll_interval": 1,
  "settings": [
    {"name": "title", "type": "text", "label": {"en": "Screen title", "fr": "Titre de l’écran"}, "default": "Focus", "required": true},
    {"name": "minutes", "type": "number", "label": {"en": "Focus duration (minutes)", "fr": "Durée de concentration (minutes)"}, "min": 1, "max": 180, "default": 25},
    {"name": "show_breaks", "type": "boolean", "label": {"en": "Include break presets", "fr": "Afficher les pauses prédéfinies"}, "default": true}
  ],
  "actions": [
    {"id": "toggle", "title": {"en": "Start / pause timer", "fr": "Démarrer / pause"}, "description": {"en": "Start or pause the current timer.", "fr": "Démarre ou met en pause le minuteur."}, "icon": "play", "color": "#66CB10", "state": "running"},
    {"id": "reset", "title": {"en": "Reset timer", "fr": "Réinitialiser"}, "icon": "refresh", "color": "#A0A0AA"},
    {"id": "start", "title": {"en": "Start a timer", "fr": "Lancer un minuteur"}, "icon": "clock", "color": "#66CB10", "arguments": [
      {"name": "minutes", "type": "number", "label": {"en": "Duration (minutes)", "fr": "Durée (minutes)"}, "description": {"en": "Choose between 1 and 180 minutes.", "fr": "Choisissez entre 1 et 180 minutes."}, "min": 1, "max": 180, "default": 25, "required": true},
      {"name": "mode", "type": "select", "label": {"en": "Session type", "fr": "Type de session"}, "default": "focus", "choices": [{"value": "focus", "label": {"en": "Focus", "fr": "Concentration"}}, {"value": "break", "label": {"en": "Break", "fr": "Pause"}}]}
    ]}
  ],
  "sources": [{"id": "presets", "title": {"en": "Focus controls", "fr": "Commandes Focus"}, "description": {"en": "Start, pause, reset and choose a duration. Works in grid and list layouts.", "fr": "Démarrer, mettre en pause, réinitialiser et choisir une durée. Compatible grille et liste."}, "icon": "clock"}],
  "dashboards": [{"id": "timer", "title": {"en": "Focus dashboard", "fr": "Tableau Focus"}, "description": {"en": "Remaining time, current mode and completed sessions.", "fr": "Temps restant, mode courant et sessions terminées."}, "icon": "clock"}]
}
