#!/bin/sh

set -eu

REPOSITORY="__REPOSITORY__"
RELEASE_TAG="__RELEASE_TAG__"
WHEEL_NAME="__WHEEL_NAME__"
WHEEL_SHA256="__WHEEL_SHA256__"
ICON_SHA256="__ICON_SHA256__"
VERSION="__VERSION__"
UV_VERSION="0.10.12"
RELEASE_URL="https://github.com/${REPOSITORY}/releases/download/${RELEASE_TAG}"
APP_DIR="${HOME}/Applications/3Decks.app"
LOG_DIR="${HOME}/Library/Logs"
LOGIN_ITEM="${HOME}/Library/LaunchAgents/com.romualdyt.3decks.plist"

step() {
    printf '\n\033[1;32m3Decks\033[0m  %s\n' "$1"
}

find_uv() {
    if command -v uv >/dev/null 2>&1; then
        command -v uv
        return 0
    fi
    for candidate in "${HOME}/.local/bin/uv" "${HOME}/.cargo/bin/uv"; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

stop_installed_agent() {
    installed_cli="$("$UV_BIN" tool dir --bin)/deck3ds"
    if [ -x "$installed_cli" ]; then
        "$installed_cli" --stop || {
            printf 'Quittez 3Decks depuis son menu puis relancez cette installation.\n' >&2
            exit 1
        }
    fi
}

if [ "${1:-}" = "--uninstall" ]; then
    step "Suppression de l'application"
    if UV_BIN="$(find_uv)"; then
        stop_installed_agent
        "$UV_BIN" tool uninstall deck3ds >/dev/null 2>&1 || true
    fi
    if [ "$APP_DIR" = "${HOME}/Applications/3Decks.app" ]; then
        rm -rf "$APP_DIR"
    fi
    if [ "$LOGIN_ITEM" = "${HOME}/Library/LaunchAgents/com.romualdyt.3decks.plist" ]; then
        rm -f "$LOGIN_ITEM"
    fi
    printf '3Decks a ete retire. Vos reglages personnels ont ete conserves.\n'
    exit 0
fi

step "Installation de la version ${VERSION}"
if ! UV_BIN="$(find_uv)"; then
    step "Preparation de l'environnement Python prive"
    curl --proto '=https' --tlsv1.2 -LsSf \
        "https://astral.sh/uv/${UV_VERSION}/install.sh" | sh
    UV_BIN="$(find_uv)" || {
        printf 'Impossible de trouver uv apres son installation.\n' >&2
        exit 1
    }
fi
stop_installed_agent

TEMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/3decks.XXXXXX")"
trap 'rm -rf "$TEMP_ROOT"' EXIT HUP INT TERM
WHEEL_PATH="${TEMP_ROOT}/${WHEEL_NAME}"
ICON_PATH="${TEMP_ROOT}/3decks-logo.png"

step "Telechargement et verification de 3Decks"
curl --proto '=https' --tlsv1.2 -fL \
    "${RELEASE_URL}/${WHEEL_NAME}" -o "$WHEEL_PATH"
curl --proto '=https' --tlsv1.2 -fL \
    "${RELEASE_URL}/3decks-logo.png" -o "$ICON_PATH"

ACTUAL_WHEEL_SHA="$(shasum -a 256 "$WHEEL_PATH" | awk '{print $1}')"
ACTUAL_ICON_SHA="$(shasum -a 256 "$ICON_PATH" | awk '{print $1}')"
if [ "$ACTUAL_WHEEL_SHA" != "$WHEEL_SHA256" ]; then
    printf 'Le paquet telecharge ne correspond pas a la version publiee.\n' >&2
    exit 1
fi
if [ "$ACTUAL_ICON_SHA" != "$ICON_SHA256" ]; then
    printf 'L icone telechargee ne correspond pas a la version publiee.\n' >&2
    exit 1
fi

"$UV_BIN" tool install --python 3.12 --force "$WHEEL_PATH"
TOOL_BIN="$("$UV_BIN" tool dir --bin)"
DECK3DS_BIN="${TOOL_BIN}/deck3ds"
DECK3DS_UI_BIN="${TOOL_BIN}/deck3ds-ui"
if [ ! -x "$DECK3DS_BIN" ] || [ ! -x "$DECK3DS_UI_BIN" ]; then
    printf 'Installation incomplete : les commandes 3Decks sont absentes.\n' >&2
    exit 1
fi

# Initialise uniquement un premier profil absent. Un profil existant, meme
# invalide, n'est jamais remplace silencieusement.
"$DECK3DS_BIN" --init-if-missing --check

step "Creation du raccourci Applications"
mkdir -p "$APP_DIR/Contents/MacOS" "$APP_DIR/Contents/Resources" "$LOG_DIR"
cp "$ICON_PATH" "$APP_DIR/Contents/Resources/3decks-logo.png"

ICONSET="${TEMP_ROOT}/3Decks.iconset"
mkdir -p "$ICONSET"
for specification in \
    "16 icon_16x16.png" "32 icon_16x16@2x.png" \
    "32 icon_32x32.png" "64 icon_32x32@2x.png" \
    "128 icon_128x128.png" "256 icon_128x128@2x.png" \
    "256 icon_256x256.png" "512 icon_256x256@2x.png" \
    "512 icon_512x512.png" "1024 icon_512x512@2x.png"; do
    size="${specification%% *}"
    name="${specification#* }"
    sips -z "$size" "$size" "$ICON_PATH" --out "$ICONSET/$name" >/dev/null
done
iconutil -c icns "$ICONSET" -o "$APP_DIR/Contents/Resources/3Decks.icns"

cat >"$APP_DIR/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDisplayName</key><string>3Decks</string>
  <key>CFBundleExecutable</key><string>3Decks</string>
  <key>CFBundleIdentifier</key><string>com.romualdyt.3decks</string>
  <key>CFBundleIconFile</key><string>3Decks.icns</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>3Decks</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>${VERSION}</string>
  <key>CFBundleVersion</key><string>${VERSION}</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
</dict></plist>
EOF

cat >"$APP_DIR/Contents/MacOS/3Decks" <<'EOF'
#!/bin/sh
set -eu
UV_BIN=""
if command -v uv >/dev/null 2>&1; then
    UV_BIN="$(command -v uv)"
elif [ -x "${HOME}/.local/bin/uv" ]; then
    UV_BIN="${HOME}/.local/bin/uv"
elif [ -x "${HOME}/.cargo/bin/uv" ]; then
    UV_BIN="${HOME}/.cargo/bin/uv"
fi
if [ -z "$UV_BIN" ]; then
    osascript -e 'display alert "3Decks ne peut pas demarrer" message "Le gestionnaire local uv est introuvable. Relancez le programme d installation."'
    exit 1
fi
DECK3DS_UI="$("$UV_BIN" tool dir --bin)/deck3ds-ui"
mkdir -p "${HOME}/Library/Logs"
export DECK3DS_DESKTOP_LAUNCHER="$0"
exec "$DECK3DS_UI" "$@"
EOF
chmod 755 "$APP_DIR/Contents/MacOS/3Decks"

step "3Decks est pret"
printf 'Le raccourci se trouve dans %s\n' "$APP_DIR"
printf 'Relancez ce programme pour mettre 3Decks a jour.\n'
open "$APP_DIR"
