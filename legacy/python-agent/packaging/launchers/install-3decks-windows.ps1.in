param(
    [switch]$Uninstall
)

$ErrorActionPreference = "Stop"
Set-StrictMode -Version Latest

$Repository = "__REPOSITORY__"
$ReleaseTag = "__RELEASE_TAG__"
$WheelName = "__WHEEL_NAME__"
$WheelSha256 = "__WHEEL_SHA256__"
$IconSha256 = "__WINDOWS_ICON_SHA256__"
$Version = "__VERSION__"
$UvVersion = "0.10.12"
$ReleaseUrl = "https://github.com/$Repository/releases/download/$ReleaseTag"
$ProductDirectory = Join-Path $env:LOCALAPPDATA "3Decks"
$StartMenuShortcut = Join-Path ([Environment]::GetFolderPath("Programs")) "3Decks.lnk"
$DesktopShortcut = Join-Path ([Environment]::GetFolderPath("Desktop")) "3Decks.lnk"
$LoginShortcut = Join-Path ([Environment]::GetFolderPath("Startup")) "3Decks.lnk"

function Write-Step([string]$Message) {
    Write-Host ""
    Write-Host "3Decks  " -ForegroundColor Green -NoNewline
    Write-Host $Message
}

function Find-Uv {
    $Command = Get-Command uv -ErrorAction SilentlyContinue
    if ($null -ne $Command) {
        return $Command.Source
    }
    foreach ($Candidate in @(
        (Join-Path $env:USERPROFILE ".local\bin\uv.exe"),
        (Join-Path $env:USERPROFILE ".cargo\bin\uv.exe")
    )) {
        if (Test-Path -LiteralPath $Candidate -PathType Leaf) {
            return $Candidate
        }
    }
    return $null
}

function Stop-InstalledAgent {
    $InstalledUv = Find-Uv
    if ($null -eq $InstalledUv) { return }
    $InstalledCli = Join-Path ((& $InstalledUv tool dir --bin).Trim()) "deck3ds.exe"
    if (Test-Path -LiteralPath $InstalledCli -PathType Leaf) {
        & $InstalledCli --stop
        if ($LASTEXITCODE -ne 0) {
            throw "Quittez 3Decks depuis son menu puis relancez cette installation."
        }
    }
}

if ($Uninstall) {
    Write-Step "Suppression de l'application"
    Stop-InstalledAgent
    $Uv = Find-Uv
    if ($null -ne $Uv) {
        & $Uv tool uninstall deck3ds 2>$null
    }
    Remove-Item -LiteralPath $StartMenuShortcut -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath $DesktopShortcut -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath $LoginShortcut -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath $ProductDirectory -Recurse -Force -ErrorAction SilentlyContinue
    Write-Host "3Decks a ete retire. Vos reglages personnels ont ete conserves."
    exit 0
}

Write-Step "Installation de la version $Version"
$Uv = Find-Uv
if ($null -eq $Uv) {
    Write-Step "Preparation de l'environnement Python prive"
    $InstallUv = Invoke-RestMethod "https://astral.sh/uv/$UvVersion/install.ps1"
    Invoke-Expression $InstallUv
    $Uv = Find-Uv
    if ($null -eq $Uv) {
        throw "Impossible de trouver uv apres son installation."
    }
}
Stop-InstalledAgent

$TemporaryDirectory = Join-Path ([IO.Path]::GetTempPath()) ("3decks-" + [guid]::NewGuid())
New-Item -ItemType Directory -Path $TemporaryDirectory | Out-Null
try {
    $WheelPath = Join-Path $TemporaryDirectory $WheelName
    $DownloadedIcon = Join-Path $TemporaryDirectory "3decks.ico"

    Write-Step "Telechargement et verification de 3Decks"
    Invoke-WebRequest "$ReleaseUrl/$WheelName" -OutFile $WheelPath
    Invoke-WebRequest "$ReleaseUrl/3decks.ico" -OutFile $DownloadedIcon
    $ActualWheelHash = (Get-FileHash -LiteralPath $WheelPath -Algorithm SHA256).Hash.ToLowerInvariant()
    $ActualIconHash = (Get-FileHash -LiteralPath $DownloadedIcon -Algorithm SHA256).Hash.ToLowerInvariant()
    if ($ActualWheelHash -ne $WheelSha256) {
        throw "Le paquet telecharge ne correspond pas a la version publiee."
    }
    if ($ActualIconHash -ne $IconSha256) {
        throw "L'icone telechargee ne correspond pas a la version publiee."
    }

    & $Uv tool install --python 3.12 --force $WheelPath
    if ($LASTEXITCODE -ne 0) {
        throw "L'installation Python de 3Decks a echoue."
    }
    $ToolBin = (& $Uv tool dir --bin).Trim()
    $Deck3DS = Join-Path $ToolBin "deck3ds.exe"
    $Deck3DSUi = Join-Path $ToolBin "deck3ds-ui.exe"
    if (!(Test-Path -LiteralPath $Deck3DS -PathType Leaf) -or !(Test-Path -LiteralPath $Deck3DSUi -PathType Leaf)) {
        throw "Installation incomplete : les commandes 3Decks sont absentes."
    }

    # Initialise uniquement un premier profil absent. Un profil existant,
    # meme invalide, ne sera jamais remplace silencieusement.
    & $Deck3DS --init-if-missing --check
    if ($LASTEXITCODE -ne 0) {
        throw "La configuration 3Decks existante doit etre corrigee."
    }

    Write-Step "Creation des raccourcis"
    New-Item -ItemType Directory -Path $ProductDirectory -Force | Out-Null
    $InstalledIcon = Join-Path $ProductDirectory "3decks.ico"
    Copy-Item -LiteralPath $DownloadedIcon -Destination $InstalledIcon -Force
    $Shell = New-Object -ComObject WScript.Shell
    foreach ($ShortcutPath in @($StartMenuShortcut, $DesktopShortcut)) {
        $Shortcut = $Shell.CreateShortcut($ShortcutPath)
        $Shortcut.TargetPath = $Deck3DSUi
        $Shortcut.WorkingDirectory = $env:USERPROFILE
        $Shortcut.IconLocation = "$InstalledIcon,0"
        $Shortcut.Description = "Piloter votre ordinateur depuis une Nintendo 3DS"
        $Shortcut.Save()
    }

    Write-Step "3Decks est pret"
    Write-Host "Un raccourci a ete ajoute au menu Demarrer et au Bureau."
    Write-Host "Relancez ce programme pour mettre 3Decks a jour."
    Start-Process -FilePath $Deck3DSUi
}
finally {
    Remove-Item -LiteralPath $TemporaryDirectory -Recurse -Force -ErrorAction SilentlyContinue
}
