{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3Decks",
  "version": "1.0.0",
  "identifier": "com.romualdyt.3decks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob: https://static-cdn.jtvnw.net/badges/v1/" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "infoPlist": "Info.plist" }
  }
}
