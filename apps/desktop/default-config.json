{
  "revision": 30,
  "server": {
    "host": "0.0.0.0",
    "port": 38123,
    "token": "",
    "poll_interval": 1.0,
    "volume_step": 5
  },
  "features": {
    "notifications": true,
    "media": true,
    "media_artwork": true,
    "lyrics_online": false,
    "windows": true,
    "audio_output": true,
    "system_stats": true,
    "apple_music": true,
    "spotify": true
  },
  "integrations": {
    "obs": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 4455,
      "password": "",
      "timeout": 2.0
    }
  },
  "pages": [
    {
      "id": "main",
      "title": {
        "en": "Home",
        "fr": "Accueil"
      },
      "icon": "star",
      "dashboard": "auto",
      "buttons": [
        {
          "id": "browser",
          "slot": 0,
          "label": {
            "en": "Browser",
            "fr": "Navigateur"
          },
          "icon": "browser",
          "color": "#3B82F6",
          "action": {
            "type": "app.launch",
            "target": "Safari"
          }
        },
        {
          "id": "files",
          "slot": 1,
          "label": {
            "en": "Files",
            "fr": "Fichiers"
          },
          "icon": "folder",
          "color": "#FBBF24",
          "action": {
            "type": "path.open",
            "path": "~"
          }
        },
        {
          "id": "lock",
          "slot": 2,
          "label": {
            "en": "Lock",
            "fr": "Verrouiller"
          },
          "icon": "lock",
          "color": "#F87171",
          "action": "system.lock"
        },
        {
          "id": "capture",
          "slot": 3,
          "label": "Capture",
          "icon": "video",
          "color": "#66CB10",
          "action": {
            "type": "hotkey",
            "keys": "cmd+shift+4"
          }
        },
        {
          "id": "mic",
          "slot": 4,
          "label": {
            "en": "Mic",
            "fr": "Micro"
          },
          "icon": "mic",
          "color": "#F59E0B",
          "toggle": "mic_muted",
          "action": "mic.mute_toggle"
        },
        {
          "id": "volumes",
          "slot": 5,
          "label": "Volumes",
          "icon": "volume-up",
          "color": "#6EE7B7",
          "hold_label": {
            "en": "Mute",
            "fr": "Muet"
          },
          "action": "modal.volumes",
          "hold_action": "volume.mute_toggle"
        }
      ]
    },
    {
      "id": "sound",
      "title": {
        "en": "Music",
        "fr": "Musique"
      },
      "icon": "music",
      "dashboard": "media",
      "buttons": [
        {
          "id": "previous",
          "slot": 0,
          "label": {
            "en": "Previous",
            "fr": "Précédent"
          },
          "icon": "previous",
          "color": "#6EE7B7",
          "action": "media.previous"
        },
        {
          "id": "play",
          "slot": 1,
          "label": {
            "en": "Play",
            "fr": "Lecture"
          },
          "icon": "play",
          "color": "#1DB954",
          "toggle": "playing",
          "action": "media.play_pause"
        },
        {
          "id": "next",
          "slot": 2,
          "label": {
            "en": "Next",
            "fr": "Suivant"
          },
          "icon": "next",
          "color": "#6EE7B7",
          "action": "media.next"
        },
        {
          "id": "vol",
          "slot": 3,
          "label": "Volumes",
          "icon": "volume-up",
          "color": "#3B82F6",
          "action": "modal.volumes"
        },
        {
          "id": "output",
          "slot": 4,
          "label": {
            "en": "Output",
            "fr": "Sortie"
          },
          "icon": "volume-up",
          "color": "#A78BFA",
          "action": "audio_output.cycle"
        },
        {
          "id": "frame",
          "slot": 5,
          "label": {
            "en": "Artwork",
            "fr": "Pochette"
          },
          "icon": "artwork",
          "color": "#8B5CF6",
          "hold_label": {
            "en": "Mute",
            "fr": "Muet"
          },
          "action": "frame.toggle",
          "hold_action": "volume.mute_toggle"
        }
      ]
    },
    {
      "id": "windows",
      "title": {
        "en": "Applications",
        "fr": "Applications"
      },
      "icon": "app",
      "dashboard": "apps",
      "layout": "list",
      "source": "windows",
      "buttons": []
    },
    {
      "id": "computer",
      "title": {
        "en": "Computer",
        "fr": "Ordinateur"
      },
      "icon": "status",
      "dashboard": "system",
      "layout": "list",
      "source": "",
      "buttons": [
        {
          "id": "files",
          "slot": 0,
          "label": {
            "en": "Files",
            "fr": "Fichiers"
          },
          "icon": "folder",
          "color": "#FBBF24",
          "action": {
            "type": "path.open",
            "path": "~"
          }
        },
        {
          "id": "terminal",
          "slot": 1,
          "label": "Terminal",
          "icon": "terminal",
          "color": "#94A3B8",
          "action": {
            "type": "app.launch",
            "target": "Terminal"
          }
        },
        {
          "id": "lock",
          "slot": 2,
          "label": {
            "en": "Lock",
            "fr": "Verrouiller"
          },
          "icon": "lock",
          "color": "#F87171",
          "action": "system.lock"
        },
        {
          "id": "settings",
          "slot": 3,
          "label": {
            "en": "Settings",
            "fr": "Réglages"
          },
          "icon": "gear",
          "color": "#64748B",
          "action": "settings.open"
        }
      ]
    }
  ]
}
