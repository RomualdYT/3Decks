{
  "name": "3decks-agent-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript ../docs/api/openapi.json -o frontend/src/api/generated.ts --default-non-nullable false",
    "api:check": "openapi-typescript ../docs/api/openapi.json -o frontend/src/api/generated.ts --default-non-nullable false --check",
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --project frontend/tsconfig.json --noEmit",
    "test:frontend": "vitest run --config frontend/vitest.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
